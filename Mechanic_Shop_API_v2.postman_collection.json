{
  "info": {
    "name": "Mechanic Shop API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:5000"
    },
    {
      "key": "auth_token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Customer",
      "item": [
        {
          "name": "Create Customer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Smith\",\n  \"email\": \"jsmith@email.com\",\n  \"phone\": \"555-123-4567\",\n  \"password\": \"mypassword123\"\n}"
            },
            "url": { "raw": "{{base_url}}/customers/", "host": ["{{base_url}}"], "path": ["customers", ""] }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"jsmith@email.com\",\n  \"password\": \"mypassword123\"\n}"
            },
            "url": { "raw": "{{base_url}}/customers/login", "host": ["{{base_url}}"], "path": ["customers", "login"] }
          }
        },
        {
          "name": "Get All Customers (paginated)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/customers/?page=1&per_page=10",
              "host": ["{{base_url}}"],
              "path": ["customers", ""],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "per_page", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Get Customer by ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/customers/1", "host": ["{{base_url}}"], "path": ["customers", "1"] }
          }
        },
        {
          "name": "Get My Tickets (requires token)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }],
            "url": { "raw": "{{base_url}}/customers/my-tickets", "host": ["{{base_url}}"], "path": ["customers", "my-tickets"] }
          }
        },
        {
          "name": "Update Customer (requires token, partial allowed)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"555-999-0000\"\n}"
            },
            "url": { "raw": "{{base_url}}/customers/", "host": ["{{base_url}}"], "path": ["customers", ""] }
          }
        },
        {
          "name": "Delete Customer (requires token)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }],
            "url": { "raw": "{{base_url}}/customers/", "host": ["{{base_url}}"], "path": ["customers", ""] }
          }
        }
      ]
    },
    {
      "name": "Mechanic",
      "item": [
        {
          "name": "Create Mechanic",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alex Torres\",\n  \"email\": \"atorres@shop.com\",\n  \"phone\": \"555-222-3333\",\n  \"salary\": 55000\n}"
            },
            "url": { "raw": "{{base_url}}/mechanics/", "host": ["{{base_url}}"], "path": ["mechanics", ""] }
          }
        },
        {
          "name": "Get All Mechanics (cached 60s)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/mechanics/", "host": ["{{base_url}}"], "path": ["mechanics", ""] }
          }
        },
        {
          "name": "Get Mechanics by Most Tickets",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/mechanics/most-tickets", "host": ["{{base_url}}"], "path": ["mechanics", "most-tickets"] }
          }
        },
        {
          "name": "Update Mechanic (partial allowed)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"salary\": 60000\n}"
            },
            "url": { "raw": "{{base_url}}/mechanics/1", "host": ["{{base_url}}"], "path": ["mechanics", "1"] }
          }
        },
        {
          "name": "Delete Mechanic",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{base_url}}/mechanics/1", "host": ["{{base_url}}"], "path": ["mechanics", "1"] }
          }
        }
      ]
    },
    {
      "name": "Service Ticket",
      "item": [
        {
          "name": "Create Service Ticket",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"VIN\": \"1HGCM82633A004352\",\n  \"service_date\": \"2026-07-27\",\n  \"service_desc\": \"Oil change and tire rotation\",\n  \"customer_id\": 1\n}"
            },
            "url": { "raw": "{{base_url}}/service-tickets/", "host": ["{{base_url}}"], "path": ["service-tickets", ""] }
          }
        },
        {
          "name": "Get All Service Tickets",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/service-tickets/", "host": ["{{base_url}}"], "path": ["service-tickets", ""] }
          }
        },
        {
          "name": "Assign Mechanic to Ticket",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{base_url}}/service-tickets/1/assign-mechanic/1",
              "host": ["{{base_url}}"],
              "path": ["service-tickets", "1", "assign-mechanic", "1"]
            }
          }
        },
        {
          "name": "Remove Mechanic from Ticket",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{base_url}}/service-tickets/1/remove-mechanic/1",
              "host": ["{{base_url}}"],
              "path": ["service-tickets", "1", "remove-mechanic", "1"]
            }
          }
        },
        {
          "name": "Bulk Edit Mechanics on Ticket",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"add_ids\": [1],\n  \"remove_ids\": []\n}"
            },
            "url": {
              "raw": "{{base_url}}/service-tickets/1/edit",
              "host": ["{{base_url}}"],
              "path": ["service-tickets", "1", "edit"]
            }
          }
        },
        {
          "name": "Add Part to Ticket",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{base_url}}/service-tickets/1/add-part/1",
              "host": ["{{base_url}}"],
              "path": ["service-tickets", "1", "add-part", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "Inventory",
      "item": [
        {
          "name": "Create Part",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Brake Pad\",\n  \"price\": 45.99\n}"
            },
            "url": { "raw": "{{base_url}}/inventory/", "host": ["{{base_url}}"], "path": ["inventory", ""] }
          }
        },
        {
          "name": "Get All Parts",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/inventory/", "host": ["{{base_url}}"], "path": ["inventory", ""] }
          }
        },
        {
          "name": "Get Part by ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/inventory/1", "host": ["{{base_url}}"], "path": ["inventory", "1"] }
          }
        },
        {
          "name": "Update Part (partial allowed)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 52.99\n}"
            },
            "url": { "raw": "{{base_url}}/inventory/1", "host": ["{{base_url}}"], "path": ["inventory", "1"] }
          }
        },
        {
          "name": "Delete Part",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{base_url}}/inventory/1", "host": ["{{base_url}}"], "path": ["inventory", "1"] }
          }
        }
      ]
    }
  ]
}
